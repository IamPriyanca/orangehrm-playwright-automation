{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  "include": [
    "pages/**/*.ts",
    "tests/**/*.ts",
    "step-definitions/**/*.ts",
    "hooks/**/*.ts",
    "utils/**/*.ts"
  ]
}